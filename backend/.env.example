# Supabase Postgres connection (Project Settings → Database → Connection string).
# Use the Session pooler (port 5432) or direct connection; keep the +psycopg driver.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# https://<project-ref>.supabase.co — user JWTs are verified against its JWKS.
SUPABASE_URL=https://<project-ref>.supabase.co
# Only needed if the project still signs tokens with the legacy HS256 JWT secret.
SUPABASE_JWT_SECRET=

# Allowed browser origins: a URL, a comma-separated list, or a JSON list.
CORS_ORIGINS=http://localhost:5173

QUIZ_TIMEZONE=Asia/Kolkata

# Server-side AI (heritage guide, king chat, Bhasha). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
AI_REQUESTS_PER_MINUTE=10

# Supabase secret key (sb_secret_…) — server-only, for Rasoi recipe photos/audio in Storage.
SUPABASE_SECRET_KEY=
RECIPE_MEDIA_BUCKET=mirava-recipe-media
# Must be a vision-capable model (Sentinel photo screening).
SENTINEL_VISION_MODEL=openai/gpt-4o-mini

# Outgoing auth emails (confirmation, magic link, password reset) are sent by the
# backend, not Supabase's rate-limited mailer. Preferred: Google Apps Script web app
# (email/apps-script/README.md). Alternatives: SMTP_HOST/SMTP_PORT/SMTP_USERNAME/
# SMTP_PASSWORD (e.g. Gmail + app password) or RESEND_API_KEY + EMAIL_FROM.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
# Public frontend URL used in email links (defaults to the first CORS origin).
SITE_URL=
